# ==============================================================================
# GMACGROUP Environment Configuration Template
# Copy this file to .env or backend/.env and fill in real values.
# NEVER commit real .env files to version control.
# ==============================================================================

# --- Environment ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Backend Database (PostgreSQL / Supabase Postgres) ---
DATABASE_URL=postgresql://user:password@localhost:5432/gmacgroup

# --- Supabase Storage & Services ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Authentication & JWT ---
JWT_SECRET=generate-a-strong-secret-key
JWT_ALGORITHM=HS256

# --- Email Notifications ---
# Set to false to completely disable outbound email sending from the backend.
EMAIL_NOTIFICATIONS_ENABLED=true

# Option 1: Brevo (good production choice when you have a verified sender identity)
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=your_brevo_v3_api_key
# EMAIL_FROM=your_verified_sender@example.com
# EMAIL_FROM_NAME=GMACGROUP
# OPERATIONS_EMAIL=workdisal480@gmail.com

# Option 2: Gmail SMTP (works immediately without a domain, but less reliable for production)
#   - Create a Google App Password at: https://myaccount.google.com/apppasswords
#   - Set EMAIL_PROVIDER=smtp
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourcompany@gmail.com
# SMTP_PASSWORD=your_16_char_google_app_password
# SMTP_TLS=true
# EMAIL_FROM=GMACGROUP <yourcompany@gmail.com>
# OPERATIONS_EMAIL=workdisal480@gmail.com

# Option 3: Resend (Requires a verified custom domain to send to external inboxes)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM=GMACGROUP <onboarding@resend.dev>

# Option 4: Development console logging (no real email dispatched, links printed to terminal)
# EMAIL_PROVIDER=none


# --- Storage Provider (for resumes / documents) ---
# Options: "supabase" (recommended for production) or "local" (saves to uploads/ folder)
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=resumes
MAX_UPLOAD_SIZE_MB=10

# --- Payment Processing (Flutterwave) ---
FLW_SECRET_KEY=your_flutterwave_secret_key
FLW_WEBHOOK_SECRET_HASH=your_flutterwave_webhook_secret_hash

# --- AI Provider (Optional) ---
AI_PROVIDER_API_KEY=

